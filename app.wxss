@import './styles/tokens.wxss';

page {
  width: 100%;
  /* Use min-height so tab pages (plaza) can grow and scroll natively.
     Build page still locks bounce via its own .page + disableScroll. */
  min-height: 100%;
  margin: 0;
  padding: 0;
  background: var(--mega-window);
  overflow-x: hidden;
  color: var(--mega-ink-soft);
}

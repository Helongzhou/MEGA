@import '../../styles/clay.wxss';

.hello { margin-bottom: 28rpx; }
.hello__hi { display: block; font-size: 26rpx; color: #6e7387; font-weight: 700; }
.age {
  display: inline-flex;
  margin-top: 16rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #7161ef;
  font-size: 22rpx;
  font-weight: 800;
}
.cats {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}
.cat {
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: #f4f2fc;
  font-size: 24rpx;
  font-weight: 800;
}
.cat--on { background: #7161ef; color: #fff; }
.goal {
  margin-bottom: 28rpx;
  padding: 32rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #8a7dfb 0%, #6554e6 100%);
  box-shadow: 0 16rpx 32rpx rgba(113, 97, 239, 0.28);
}
.goal__title { display: block; color: #fff; font-size: 34rpx; font-weight: 800; }
.goal__sub, .goal__count { display: block; color: rgba(255,255,255,0.9); font-size: 24rpx; margin-top: 8rpx; }
.goal__bar {
  margin-top: 18rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: rgba(76, 61, 199, 0.45);
  overflow: hidden;
  padding: 2rpx;
}
.goal__fill {
  height: 100%;
  border-radius: 999rpx;
  background: #fff;
}
.block-h { margin: 12rpx 0 16rpx; }
.block-h__t { font-size: 32rpx; }
.continue {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  margin-bottom: 28rpx;
}
.continue__art { width: 120rpx; height: 120rpx; border-radius: 28rpx; }
.continue__body { flex: 1; }
.continue__name { display: block; font-size: 32rpx; font-weight: 800; }
.play {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #6d5ce7;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
}
.search {
  width: 100%;
  height: 76rpx;
  margin: 12rpx 0;
  padding: 0 28rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #fff;
  font-size: 28rpx;
}
.chip-scroll {
  width: 100%;
  height: 72rpx;
  white-space: nowrap;
  margin-bottom: 16rpx;
}
.chip-row {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  height: 72rpx;
}
.grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.tile { width: calc(50% - 12rpx); margin-bottom: 24rpx; padding: 16rpx; box-sizing: border-box; }
.tile__art {
  height: 180rpx;
  border-radius: 24rpx;
  position: relative;
  margin-bottom: 12rpx;
}
.badge {
  position: absolute;
  top: 12rpx;
  background: #fff;
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  font-weight: 800;
}
.badge--hot { left: 12rpx; color: #b45309; background: #fef3c7; }
.badge--piece { right: 12rpx; }
.badge--ok { background: #d1fae5; color: #047857; }
.tile__name { display: block; font-size: 28rpx; font-weight: 800; }
.empty { padding: 32rpx; margin-bottom: 24rpx; }

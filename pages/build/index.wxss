@import '../../styles/tokens.wxss';

.page {
  display: flex;
  flex-direction: column;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: var(--mega-chrome);
}

.chrome {
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
  background: var(--mega-chrome);
  z-index: 2;
}

.chrome--top {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.brand-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 2px var(--mega-pad-x) 0;
  box-sizing: border-box;
}

.back-btn {
  min-width: 52px;
  height: 44px;
  margin-right: 8px;
  padding: 0 10px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: var(--mega-accent);
  color: var(--mega-ink);
  font-size: 15px;
  font-weight: var(--mega-fw-bold);
  line-height: 1;
}

.brand-row__mark {
  color: var(--mega-accent);
  font-size: var(--mega-fs-brand);
  font-weight: var(--mega-fw-bold);
  letter-spacing: 0.08em;
  line-height: 1.2;
}

.brand-row__sub {
  margin-left: 6px;
  color: var(--mega-ink-muted);
  font-size: var(--mega-fs-caption);
  font-weight: var(--mega-fw-semi);
  letter-spacing: 0.12em;
}

.brand-row__spacer {
  flex: 1;
}

.brand-row__work {
  color: var(--mega-ink-soft);
  font-size: var(--mega-fs-title);
  font-weight: var(--mega-fw-semi);
}

.chrome--bottom {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.progress-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 4px var(--mega-pad-x) 0;
  box-sizing: border-box;
}

.progress-track {
  flex: 1;
  height: 8px;
  border-radius: 4px;
  background: var(--mega-chrome-elevated);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 4px;
  background: linear-gradient(90deg, var(--mega-accent-teal), var(--mega-accent));
  transition: width 0.2s ease-out;
}

.progress-meta {
  margin-left: 10px;
  min-width: 48px;
  text-align: right;
  color: var(--mega-ink-soft);
  font-size: var(--mega-fs-caption);
  font-weight: var(--mega-fw-bold);
  letter-spacing: 0.02em;
}

.work-hint {
  text-align: center;
  color: var(--mega-ink-soft);
  font-size: 12px;
  padding: 4px 8px 8px;
}

.work-hint--showcase {
  color: var(--mega-accent);
  font-size: 14px;
  font-weight: var(--mega-fw-semi);
  letter-spacing: 0.04em;
}

.work-hint--done {
  color: var(--mega-accent-teal);
  font-size: 13px;
  font-weight: var(--mega-fw-semi);
}

.progress-fill--done {
  background: linear-gradient(90deg, var(--mega-accent), #fff3a8);
}

.chrome--celebrate {
  box-shadow: inset 0 1px 0 rgba(255, 230, 109, 0.22);
}

.icon-btn--pulse {
  animation: mega-pulse 1.2s ease-in-out infinite;
}

.icon-btn--replay {
  background: var(--mega-accent-teal);
  border-color: #3dbdb5;
}

@keyframes mega-pulse {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.06);
  }
}

.stage {
  flex: 1 1 auto;
  width: 100%;
  position: relative;
  background: var(--mega-stage);
  overflow: hidden;
  z-index: 1;
}

.xr {
  width: 100%;
  height: 100%;
  display: block;
}

/* Stage-local masks only (not page chrome overlaying XR). */
.stage-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(245, 239, 230, 0.94);
  padding: 24px;
  box-sizing: border-box;
}

.stage-mask--error {
  background: rgba(255, 232, 230, 0.96);
}

.stage-mask__title {
  color: var(--mega-ink);
  font-size: 18px;
  font-weight: var(--mega-fw-bold);
}

.stage-mask__sub {
  margin-top: 8px;
  color: var(--mega-ink-muted);
  font-size: var(--mega-fs-body);
  text-align: center;
}

.toolbar {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 8px 10px;
  box-sizing: border-box;
}

.toolbar__row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.icon-btn {
  width: var(--mega-touch);
  height: var(--mega-touch);
  min-width: var(--mega-touch);
  margin: 0 5px;
  border-radius: var(--mega-radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--mega-btn-face);
  box-sizing: border-box;
  border: 2px solid var(--mega-btn-border);
}

.icon-btn--primary {
  background: var(--mega-btn-primary);
  border-color: var(--mega-btn-primary-border);
}

.icon-btn__img {
  width: 28px;
  height: 28px;
}

.icon-btn__glyph {
  color: var(--mega-ink);
  font-size: 18px;
  font-weight: var(--mega-fw-bold);
  line-height: 1;
}

.icon-btn--muted {
  background: #d6d3d1;
  border-color: #a8a29e;
}

.icon-btn:active {
  opacity: 0.85;
}

.mode-chip {
  min-width: 52px;
  height: var(--mega-touch);
  margin: 0 5px;
  padding: 0 12px;
  border-radius: var(--mega-radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: var(--mega-chrome-elevated);
  border: 2px solid #44403c;
}

.mode-chip--on {
  background: var(--mega-accent-warm-soft);
  border-color: var(--mega-accent-warm);
}

.mode-chip__text {
  color: var(--mega-ink-soft);
  font-size: 14px;
  font-weight: var(--mega-fw-bold);
}

.mode-chip--on .mode-chip__text {
  color: var(--mega-ink);
}

.mode-chip:active {
  opacity: 0.85;
}

.speed-group {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-left: 2px;
  padding: 3px;
  border-radius: var(--mega-radius-pill);
  background: var(--mega-chrome-elevated);
}

.speed-chip {
  min-width: 52px;
  height: 48px;
  margin: 0 2px;
  padding: 0 12px;
  border-radius: var(--mega-radius-chip);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2px solid transparent;
  background: transparent;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.speed-chip--on {
  background: var(--mega-accent-warm-soft);
  border-color: var(--mega-accent-warm);
}

.speed-chip__text {
  color: var(--mega-ink-soft);
  font-size: 16px;
  font-weight: var(--mega-fw-bold);
  letter-spacing: 0.02em;
  line-height: 1;
}

.speed-chip--on .speed-chip__text {
  color: var(--mega-ink);
}

.speed-chip:active {
  opacity: 0.85;
}

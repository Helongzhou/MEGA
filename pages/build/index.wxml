<!--
  UX contract (quality > speed):
  - DevTools cannot reliably same-layer-render over xr-frame.
  - Therefore chrome is NOT an overlay. It occupies real layout space.
  - xr-builder is height-constrained to the middle band only
    (native canvas must not be style height:100vh).
  - Final visual sign-off: 真机预览 still required.
-->
<view class="page">
  <view class="chrome chrome--top" style="padding-top: {{statusBarHeight}}px; height: {{topChromeHeight}}px;">
    <view class="brand-row">
      <view class="back-btn" catchtap="onBack" aria-role="button" aria-label="返回">返回</view>
      <text class="brand-row__mark">MEGA</text>
      <text class="brand-row__sub">磁力片</text>
      <view class="brand-row__spacer" />
      <text class="brand-row__work">{{activeWorkTitle}}</text>
    </view>

    <view class="progress-row">
      <view class="progress-track">
        <view class="progress-fill {{completed || showcasing ? 'progress-fill--done' : ''}}" style="width: {{progressPct}}%;"></view>
      </view>
      <text class="progress-meta">{{stepLabel}}</text>
    </view>

    <view
      wx:if="{{hintsOn}}"
      class="work-hint {{showcasing ? 'work-hint--showcase' : ''}} {{completed && !showcasing ? 'work-hint--done' : ''}}"
      catchtap="onHintTap"
    >
      <text>{{hintText}}</text>
    </view>
  </view>

  <view class="stage" style="height: {{stageHeight}}px;">
    <xr-builder
      wx:if="{{hasWorks}}"
      id="builder"
      class="xr"
      width="{{renderWidth}}"
      height="{{renderHeight}}"
      style="width:{{width}}px;height:{{stageHeight}}px;display:block;"
      workIndex="{{workIndex}}"
      mode="{{mode}}"
      isAutoPlaying="{{isAutoPlaying}}"
      isPaused="{{isPaused}}"
      muted="{{muted}}"
      speedMultiplier="{{speedMultiplier}}"
      commandSeq="{{commandSeq}}"
      command="{{command}}"
      commandArg="{{commandArg}}"
      bind:scene-ready="onSceneReady"
      bind:state="onBuilderState"
      bind:celebrate="onCelebrate"
      bind:showcase-start="onShowcaseStart"
      bind:showcase-end="onShowcaseEnd"
      bind:request-pause="onRequestPause"
      bind:replay-done="onReplayDone"
    />
    <view wx:if="{{!hasWorks}}" class="stage-mask">
      <text class="stage-mask__title">还没有可以搭的作品</text>
      <text class="stage-mask__sub">先回首页挑一个吧</text>
    </view>
    <view wx:elif="{{!sceneReady && !sceneError}}" class="stage-mask">
      <text class="stage-mask__title">片片马上就来</text>
      <text class="stage-mask__sub">稍等一下就好看啦</text>
    </view>
    <view wx:elif="{{sceneError}}" class="stage-mask stage-mask--error">
      <text class="stage-mask__title">画面还没准备好</text>
      <text class="stage-mask__sub">{{sceneErrorText}}</text>
    </view>
  </view>

  <view class="chrome chrome--bottom {{completed || showcasing ? 'chrome--celebrate' : ''}}" style="padding-bottom: {{safeBottom}}px; height: {{bottomChromeHeight}}px;">
    <view class="toolbar">
      <view class="toolbar__row">
        <view
          class="icon-btn icon-btn--primary {{showcasing ? 'icon-btn--pulse' : ''}} {{completed && !showcasing ? 'icon-btn--replay' : ''}}"
          catchtap="onTogglePlay"
          aria-role="button"
          aria-label="{{completed || showcasing ? '重播' : (isPaused || !isAutoPlaying ? '播放' : '暂停')}}"
        >
          <image
            wx:if="{{completed || showcasing}}"
            class="icon-btn__img"
            src="/assets/icons/replay.png"
            mode="aspectFit"
          />
          <image
            wx:elif="{{isPaused || !isAutoPlaying}}"
            class="icon-btn__img"
            src="/assets/icons/play.png"
            mode="aspectFit"
          />
          <image
            wx:else
            class="icon-btn__img"
            src="/assets/icons/pause.png"
            mode="aspectFit"
          />
        </view>

        <view class="icon-btn" catchtap="onPrev" aria-role="button" aria-label="上一步">
          <image class="icon-btn__img" src="/assets/icons/prev.png" mode="aspectFit" />
        </view>
        <view class="icon-btn" catchtap="onNext" aria-role="button" aria-label="下一步">
          <image class="icon-btn__img" src="/assets/icons/next.png" mode="aspectFit" />
        </view>
      </view>

      <view class="toolbar__row">
      <view
        class="icon-btn {{muted ? 'icon-btn--muted' : ''}}"
        catchtap="onToggleMute"
        aria-role="button"
        aria-label="{{muted ? '打开声音' : '静音'}}"
      >
        <text class="icon-btn__glyph">{{muted ? '静' : '音'}}</text>
      </view>

      <view
        class="mode-chip {{mode === 'manual' ? 'mode-chip--on' : ''}}"
        catchtap="onToggleMode"
        aria-role="button"
        aria-label="{{mode === 'watch' ? '切换到手动' : '切换到观看'}}"
      >
        <text class="mode-chip__text">{{mode === 'watch' ? '观看' : '手动'}}</text>
      </view>

      <view class="speed-group">
        <view
          wx:for="{{speedPresets}}"
          wx:key="label"
          class="speed-chip {{speedIndex === index ? 'speed-chip--on' : ''}}"
          data-index="{{index}}"
          catchtap="onSpeed"
          aria-role="button"
          aria-label="速度{{item.label}}"
        >
          <text class="speed-chip__text">{{item.label}}</text>
        </view>
      </view>
      </view>
    </view>
  </view>
</view>

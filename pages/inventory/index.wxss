@import '../../styles/clay.wxss';
@import '../../styles/shapes.wxss';

.lead { display: block; margin: 12rpx 0 24rpx; }
.hint {
  display: block;
  margin: 8rpx 0 20rpx;
  font-size: 22rpx;
  color: #8a8e9e;
  font-weight: 700;
}
.hero {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
  padding: 28rpx 32rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #5ecfc4 0%, #3aa89e 100%);
  box-shadow: 0 16rpx 32rpx rgba(82, 184, 172, 0.28);
  color: #fff;
}
.hero__num { font-size: 88rpx; font-weight: 800; line-height: 1; }
.hero__unit { font-size: 28rpx; font-weight: 800; margin-left: 8rpx; }
.hero__right { flex: 1; }
.hero__sub, .hero__line {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.92);
}
.kits { padding: 8rpx 24rpx; margin-bottom: 8rpx; }
.kit {
  min-height: 96rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f0eff7;
}
.kit:last-child { border-bottom: none; }
.kit__name { font-size: 30rpx; font-weight: 800; padding: 12rpx 0; }
.kit__name--on { color: #6d5ce7; }
.section {
  display: block;
  margin: 20rpx 0 12rpx;
  font-size: 30rpx;
  font-weight: 800;
}
.grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}
.shape {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  padding: 16rpx;
  margin-bottom: 20rpx;
}
.shape__name {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  margin: 8rpx 0 12rpx;
}
.stepper {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.step {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #8e82fe 0%, #6d5ce7 100%);
  color: #fff;
  font-size: 40rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 18rpx rgba(109, 92, 231, 0.25);
}
.count { font-size: 36rpx; font-weight: 800; }
.promo {
  margin-top: 8rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  border: 2rpx dashed #c4b5fd;
  background: #f4f1ff;
}
.promo__title { display: block; font-size: 30rpx; font-weight: 800; color: #2d3142; }
.promo__sub { display: block; margin-top: 6rpx; font-size: 24rpx; color: #8a8e9e; font-weight: 700; }
.danger, .ghost {
  margin-top: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
}
.danger { color: #b91c1c; background: #fff; }
.ghost {
  color: #fff;
  background: linear-gradient(145deg, #8e82fe 0%, #6d5ce7 100%);
  box-shadow: 0 12rpx 24rpx rgba(109, 92, 231, 0.28);
}

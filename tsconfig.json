{
  "compilerOptions": {
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "module": "CommonJS",
    "target": "ES2017",
    "allowJs": true,
    "experimentalDecorators": true,
    "noImplicitReturns": false,
    "alwaysStrict": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strict": false,
    "skipLibCheck": true,
    "lib": ["ES2017"],
    "typeRoots": ["./typings"]
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules"]
}

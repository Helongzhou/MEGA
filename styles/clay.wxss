page {
  background: #f6f5fa;
  color: #2d3142;
  font-weight: 600;
}

.clay-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx 48rpx;
  background: linear-gradient(180deg, #ece9f7 0%, #f6f5fa 240rpx);
}

.clay-card {
  background: linear-gradient(180deg, #ffffff 0%, #faf9fe 100%);
  border-radius: 36rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 16rpx 32rpx rgba(114, 101, 227, 0.08);
}

.clay-h {
  font-size: 40rpx;
  font-weight: 800;
  color: #2d3142;
  line-height: 1.3;
}

.clay-sub {
  font-size: 24rpx;
  color: #8a8e9e;
  font-weight: 700;
}

.pill {
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #5c6073;
  font-size: 24rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  box-shadow: 0 8rpx 18rpx rgba(114, 101, 227, 0.08);
}

.pill--on {
  background: linear-gradient(145deg, #8e82fe 0%, #6d5ce7 100%);
  color: #fff;
}

.purple-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  background: linear-gradient(145deg, #8e82fe 0%, #6d5ce7 100%);
  box-shadow: 0 12rpx 24rpx rgba(109, 92, 231, 0.28);
}
